{
  "name": "bff-sample-testing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BFF Sample Testing — digital sample testing and quality records for the Bounty Farm Limited Feed Factory",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "fn:serve": "supabase functions serve --no-verify-jwt",
    "fn:deploy": "supabase functions deploy",
    "verify:bundle": "node scripts/check-bundle-secrets.mjs",
    "verify:imports": "node scripts/check-shared-module-imports.mjs",
    "verify:sql": "scripts/verify-migrations.sh",
    "verify:rls": "scripts/verify-rls.sh",
    "verify:db": "scripts/verify-migrations.sh && scripts/verify-rls.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@supabase/supabase-js": "2.47.10",
    "@tanstack/react-query": "5.62.7",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.54.2",
    "react-router-dom": "6.28.0",
    "tailwind-merge": "2.5.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.19"
  }
}
