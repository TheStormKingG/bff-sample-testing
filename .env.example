# ---------------------------------------------------------------------------
# BFF Sample Testing — FRONTEND configuration only.
#
# Everything in this file is compiled into the published JavaScript bundle and
# is therefore PUBLIC. GitHub Pages is a public static host: assume every value
# below is readable by anybody, signed in or not.
#
# NEVER put any of the following in this file or in any VITE_* variable:
#   - the Supabase service_role key
#   - a Google service-account JSON key or private key
#   - a Google OAuth client secret
#   - a Google refresh token
#   - the Sheets spreadsheet ID
# Those are Supabase Edge Function secrets. See docs/setup.md section 3.
# `npm run verify:bundle` fails the build if any of them reach dist/.
# ---------------------------------------------------------------------------

# Supabase project URL. Public by design.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase publishable / anon key. Public by design: it carries no authority of
# its own. All read and write authority comes from Row Level Security evaluated
# against the signed-in user's JWT.
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# Shown in the UI footer and recorded on audit events so a record can be traced
# to the deployment that produced it. CI overrides this with the commit SHA.
VITE_APP_VERSION=local-dev

# Base path for the built site. '/' locally; '/<repo-name>/' on GitHub Pages.
# The deploy workflow derives this from the repository name — do not hardcode.
VITE_BASE_PATH=/
